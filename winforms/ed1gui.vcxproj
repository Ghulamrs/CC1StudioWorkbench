<?xml version="1.0" encoding="utf-8"?>
<!-- A Windows Forms front end for the same editor, in C++/CLI.

     It consumes the native core directly - the same indent.cpp, syntax.cpp,
     project.cpp and compile.cpp the terminal editor uses, compiled here as
     native code and called from managed code in the same binary. Nothing is
     duplicated and nothing is reimplemented.

     Kept deliberately plain. An earlier version of this file set OutDir,
     IntDir, BasicRuntimeChecks and a platform version, and the binary died at
     startup with heap corruption before main was ever reached - with a bare
     main, no includes and no code of ours running. This shape is the one that
     was proved to work first, with everything else added to it afterwards. -->
<Project DefaultTargets="Build" ToolsVersion="17.0"
         xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{8F4C2E61-9A73-4B5D-B2E8-6C1A0D3F7B94}</ProjectGuid>
    <Keyword>ManagedCProj</Keyword>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CLRSupport>true</CLRSupport>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ItemDefinitionGroup>
    <ClCompile>
      <ExceptionHandling>Async</ExceptionHandling>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)..\src</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Function-local statics normally get a thread-safe initialisation
           helper. In a mixed native/managed image that helper runs where the
           CLR loader lock is held, and it is a documented hazard there. The
           editor's core has a handful of them - json.cpp's empty value among
           them - and none needs the guard. -->
      <AdditionalOptions>/Zc:threadSafeInit- %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <EntryPointSymbol>main</EntryPointSymbol>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ClCompile Include="Program.cpp" />
    <ClInclude Include="MainForm.h" />
    <ClInclude Include="bridge.h" />
  </ItemGroup>

  <ItemGroup>
    <!-- The seam, and the editor's own rules. Native, because a /clr file that
         instantiates the same templates these do corrupts the heap. -->
    <ClCompile Include="bridge.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\buffer.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\indent.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\syntax.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\find.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\utf8.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\json.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\project.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\workspace.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\compile.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
    <ClCompile Include="..\src\toolchain.cpp"><CompileAsManaged>false</CompileAsManaged><ExceptionHandling>Sync</ExceptionHandling></ClCompile>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
